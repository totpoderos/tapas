# Copy to `.env` and adjust. docker-compose.yml reads this file automatically for
# variable substitution. Every value here has a safe DEV fallback baked into the
# compose file, so the stack boots without a .env — override these for anything
# beyond local development. NEVER commit a real .env (it is gitignored).

# --- API secrets (fail-fast: the API refuses to boot without them) -----------
# Both must be >= 32 chars; use 64+ RANDOM chars in any real deployment. In
# production the API also REFUSES to boot if either is left at its committed dev
# default (threat-model G1/G2) — these dev values only work with NODE_ENV!=production.
JWT_SECRET=dev-only-jwt-secret-change-me-in-production
ASSISTANT_CONFIRMATION_SECRET=dev-assistant-confirmation-secret-change-me

# The address that may claim this deployment and become its one administrator.
# There is no other way to create one, so set it before first boot. Not a
# secret, but production refuses to start while it is still this example value.
ADMIN_BOOTSTRAP_EMAIL=admin@example.com

# Where invitations are sent. These point at a local mail catcher (Mailpit).
# Nothing needs to be running: with no catcher up, an invitation's handoff fails
# and the link comes back in the response instead. Production refuses to boot
# while MAIL_HOST and MAIL_FROM are still these values.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=no-reply@tapas.example

# Where the participant app answers. It is the CORS allowlist, and it is also
# what a contest's join link — the scannable code a host holds up — is built
# from, so a wrong value sends a whole room somewhere that does not exist.
#
# Read by `npm run dev` only. The compose stack sets its own (the API service in
# docker-compose.yml), and production takes it from PARTICIPANT_DOMAIN.
#
# The default is the participant dev server, which is right for working in a
# browser on this machine and wrong for a phone: a code scanned off this screen
# resolves `localhost` to the phone, not to here. To scan one for real locally,
# set this to this machine's address on the network (e.g. http://192.168.1.20:5174).
PARTICIPANT_WEB_ORIGIN=http://localhost:5174

# --- In-app assistant model (OpenAI-compatible /chat/completions) ------------
# Defaults to an Ollama running on the HOST machine. Point at any compatible
# endpoint; leave LLM_API_KEY empty for a local Ollama.
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_MODEL=llama3.1
LLM_API_KEY=

# --- MCP server (only needed for `docker compose --profile mcp`) -------------
# MCP_HOST_TOKEN must be a REAL host personal-access token; there is no safe
# default (the server fail-fasts without it). MCP_CONFIRMATION_SECRET must be
# 32+ chars.
MCP_HOST_TOKEN=
MCP_CONFIRMATION_SECRET=dev-mcp-confirmation-secret-change-me
