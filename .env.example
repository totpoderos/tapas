# Copy to .env for local development. Never commit .env.
# Only VITE_-prefixed vars are exposed to the browser frontends.

# --- api ---
NODE_ENV=development
API_PORT=3000
DATABASE_PATH=./tapas.sqlite
# 64+ char random secret in real environments (JWT signing). Placeholder here.
JWT_SECRET=dev-only-change-me-to-a-64-char-random-string-xxxxxxxxxxxxxxxxxxx

# --- mcp ---
MCP_PORT=3001
API_BASE_URL=http://localhost:3000

# --- frontends (build-time, browser-exposed) ---
VITE_API_BASE_URL=http://localhost:3000
