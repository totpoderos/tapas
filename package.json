{
  "name": "tapas",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval:creation": "npm run eval:creation -w @tapas/evals --",
    "eval:host-assistant": "npm run eval:host-assistant -w @tapas/evals --",
    "eval:gate": "npm run eval:gate -w @tapas/evals --",
    "lint": "eslint .",
    "audit:ci": "node scripts/audit-gate.mjs",
    "format": "prettier --write .",
    "dev": "concurrently -n api,host,participant -c blue,green,cyan \"npm:dev -w @tapas/api\" \"npm:dev -w @tapas/host-web\" \"npm:dev -w @tapas/participant-web\"",
    "dev:mcp": "npm run dev -w @tapas/mcp",
    "prepare": "husky",
    "test:e2e": "playwright test",
    "eval:infra": "node scripts/infra-eval.mjs"
  },
  "devDependencies": {
    "@amiceli/vitest-cucumber": "^5.2.1",
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "eslint": "^9.18.0",
    "fast-check": "^4.9.0",
    "husky": "^9.1.7",
    "jsdom": "^25.0.1",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vite": "^6.0.7",
    "vitest": "^3.0.2"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3"
  }
}
