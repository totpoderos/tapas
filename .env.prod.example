# Production deploy config for docker-compose.prod.yml. Copy to `.env` on the
# target host and fill in. `.env` is gitignored — never commit real secrets.
#
# Every variable the stack REQUIRES is below. Filling these in is enough to
# start; nothing else has to be discovered from an error message.

# --- Image source (GHCR) -----------------------------------------------------
# The lowercase GitHub owner CD pushed under, and the tag to deploy. Leave
# REGISTRY_OWNER empty to use locally-built `tapas-*:TAG` images instead of GHCR.
REGISTRY_OWNER=totpoderos
TAG=latest

# --- Public domains + TLS ----------------------------------------------------
# Caddy obtains certificates for these automatically (Let's Encrypt). They must
# resolve to this host. TLS_EMAIL is the ACME contact.
#
# PARTICIPANT_DOMAIN is what join links and their scannable codes are built
# from, so it ends up printed and shared. Changing it later breaks every code
# already handed out — choose it before the first contest, not after.
HOST_DOMAIN=host.example.com
PARTICIPANT_DOMAIN=app.example.com
TLS_EMAIL=admin@example.com

# --- Database ----------------------------------------------------------------
# `sqlite` keeps everything on this machine's disk and needs nothing installed.
# `postgres` reads DATABASE_URL and ignores DATABASE_PATH — for a deployment
# that cannot keep a disk. Both serve the same behaviour; the suite is run
# against each before a release (`npm run test:pg`).
DATABASE_DRIVER=sqlite
DATABASE_URL=

# --- API secrets (required; the API fail-fasts without them) -----------------
# Each must be >= 32 chars (use 64+ RANDOM). In production the API refuses to
# boot on a committed dev-default value, so these MUST be real secrets, e.g.
#   openssl rand -base64 48
JWT_SECRET=
ASSISTANT_CONFIRMATION_SECRET=

# --- The administrator (required) --------------------------------------------
# Names who may claim this deployment and become its one administrator. Get it
# right before the first boot: it is read only while the deployment is
# unclaimed, and nothing in the app transfers the role afterwards.
ADMIN_BOOTSTRAP_EMAIL=

# --- Mail (required unless this deployment sends none) -----------------------
# How an invitation reaches the person invited. Mail is only ever used for HOST
# accounts — participants join by code and never receive any.
#
#   MAIL_TRANSPORT=smtp   send it. MAIL_HOST and MAIL_FROM are then required,
#                         and the API refuses to boot in production while they
#                         still point at the local dev catcher.
#   MAIL_TRANSPORT=none   this deployment has no mail server. Every invitation
#                         answers with its link instead, shown on screen for the
#                         administrator to pass on by hand. Nothing else below
#                         is read.
MAIL_TRANSPORT=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=

# --- In-app assistant model (OpenAI-compatible /chat/completions) ------------
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_MODEL=llama3.1
LLM_API_KEY=
